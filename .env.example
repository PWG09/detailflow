# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=https://detailflow-two.vercel.app

# Stripe platform + memberships + Connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...
STRIPE_APPLICATION_FEE_PERCENT=2.5

# NVIDIA NIM / OpenAI-compatible vision API
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# NVIDIA_API_KEY is also accepted as an alternative to AI_API_KEY.

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM=DetailFlow <noreply@yourdomain.com>
