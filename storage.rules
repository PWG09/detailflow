rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function member(businessId) { return signedIn() && firestore.exists(/databases/(default)/documents/businesses/$(businessId)/members/$(request.auth.uid)); }
    match /businesses/{businessId}/public-assets/{fileName} {
      allow read: if true;
      allow write: if member(businessId) && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /businesses/{businessId}/leads/{leadId}/photos/{fileName} {
      allow read: if member(businessId);
      allow write: if member(businessId) && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
